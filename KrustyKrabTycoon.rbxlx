      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Costume</string>
          <string name="Source"><![CDATA[-- A handmade sponge chef, built entirely from shapes. No catalog assets needed.
-- Decorations follow the standard R6/R15 rig and never replace its joints.
local Costume = {}

local YELLOW = Color3.fromRGB(255, 224, 58)
local PORE = Color3.fromRGB(210, 170, 36)
local WHITE = Color3.fromRGB(255, 252, 233)
local BROWN = Color3.fromRGB(139, 82, 43)
local BLACK = Color3.fromRGB(35, 30, 25)
local RED = Color3.fromRGB(210, 54, 42)

local function decorate(model, rigPart, name, size, offset, color, shape)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.Shape = shape or Enum.PartType.Block
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Anchored = false
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.CFrame = rigPart.CFrame * offset
    part.Parent = model
    local weld = Instance.new("WeldConstraint")
    weld.Name = "CostumeWeld"
    weld.Part0 = rigPart
    weld.Part1 = part
    weld.Parent = part
    return part
end

local function frame(parent, name, x, y, width, height, color, round)
    local object = Instance.new("Frame")
    object.Name = name
    object.BorderSizePixel = 0
    object.Position = UDim2.fromOffset(x, y)
    object.Size = UDim2.fromOffset(width, height)
    object.BackgroundColor3 = color
    object.Parent = parent
    if round then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(round, 0)
        corner.Parent = object
    end
    return object
end

local function addFace(body)
    local surface = Instance.new("SurfaceGui")
    surface.Name = "SpongeFace"
    surface.Face = Enum.NormalId.Front
    surface.CanvasSize = Vector2.new(512, 440)
    surface.LightInfluence = 0.15
    surface.AlwaysOnTop = false
    surface.Parent = body

    local pores = {
        { 31, 29, 41, 25 }, { 432, 24, 44, 31 }, { 71, 193, 26, 38 },
        { 438, 194, 28, 21 }, { 30, 351, 35, 45 }, { 439, 353, 41, 28 },
        { 206, 30, 20, 17 }, { 382, 389, 21, 15 }, { 102, 394, 22, 19 },
    }
    for index, pore in ipairs(pores) do
        frame(surface, "Pore" .. index, pore[1], pore[2], pore[3], pore[4], PORE, 0.5)
    end

    for index, eyeX in ipairs({ 121, 271 }) do
        local eye = frame(surface, "Eye" .. index, eyeX, 78, 120, 147, WHITE, 0.5)
        local outline = Instance.new("UIStroke")
        outline.Color = BLACK
        outline.Thickness = 3
        outline.Parent = eye
        frame(eye, "Iris", 36, 54, 52, 64, Color3.fromRGB(67, 173, 226), 0.5)
        frame(eye, "Pupil", 47, 65, 31, 44, BLACK, 0.5)
        frame(eye, "Glint", 52, 69, 10, 14, Color3.new(1, 1, 1), 0.5)
        for lashIndex = 1, 3 do
            local lash = frame(surface, "Eyelash", eyeX + 22 + (lashIndex - 1) * 34,
                54, 7, 29, BLACK, 0.3)
            lash.Rotation = (lashIndex - 2) * 25
        end
    end

    -- An open curved grin, with the yellow mask covering its upper half.
    frame(surface, "Smile", 143, 251, 226, 110, Color3.fromRGB(114, 55, 24), 0.5)
    frame(surface, "SmileMask", 140, 243, 232, 48, YELLOW)
    frame(surface, "LeftTooth", 224, 287, 29, 39, WHITE, 0.08)
    frame(surface, "RightTooth", 259, 287, 29, 39, WHITE, 0.08)
    for _, cheekX in ipairs({ 95, 374 }) do
        frame(surface, "Cheek", cheekX, 232, 46, 31, Color3.fromRGB(248, 180, 71), 0.5)
        frame(surface, "Freckle", cheekX + 5, 241, 7, 7, RED, 0.5)
        frame(surface, "Freckle", cheekX + 18, 247, 7, 7, RED, 0.5)
        frame(surface, "Freckle", cheekX + 30, 239, 7, 7, RED, 0.5)
    end
end

local function dressArms(character, model)
    for _, side in ipairs({ "Left", "Right" }) do
        local upper = character:FindFirstChild(side .. "UpperArm")
        local lower = character:FindFirstChild(side .. "LowerArm")
        local hand = character:FindFirstChild(side .. "Hand")
        local classic = character:FindFirstChild(side .. " Arm")
        if upper and lower and hand then
            decorate(model, upper, side .. "Sleeve", Vector3.new(0.58, 0.45, 0.62),
                CFrame.new(0, upper.Size.Y * 0.29, 0), WHITE)
            for _, limb in ipairs({ upper, lower }) do
                decorate(model, limb, side .. "Arm", Vector3.new(0.24, limb.Size.Y, 0.27),
                    CFrame.identity, YELLOW)
            end
            decorate(model, hand, side .. "Hand", Vector3.new(0.42, 0.43, 0.34),
                CFrame.identity, YELLOW, Enum.PartType.Ball)
        elseif classic then
            decorate(model, classic, side .. "Sleeve", Vector3.new(0.6, 0.46, 0.68),
                CFrame.new(0, classic.Size.Y * 0.35, 0), WHITE)
            decorate(model, classic, side .. "Arm", Vector3.new(0.25, classic.Size.Y * 0.8, 0.28),
                CFrame.new(0, -0.1, 0), YELLOW)
            decorate(model, classic, side .. "Hand", Vector3.new(0.42, 0.42, 0.34),
                CFrame.new(0, -classic.Size.Y * 0.45, 0), YELLOW, Enum.PartType.Ball)
        end
    end
end

local function dressLegs(character, model)
    for _, side in ipairs({ "Left", "Right" }) do
        local upper = character:FindFirstChild(side .. "UpperLeg")
        local lower = character:FindFirstChild(side .. "LowerLeg")
        local foot = character:FindFirstChild(side .. "Foot")
        local classic = character:FindFirstChild(side .. " Leg")
        if upper and lower and foot then
            decorate(model, upper, side .. "ShortLeg", Vector3.new(0.7, upper.Size.Y * 0.52, 0.76),
                CFrame.new(0, upper.Size.Y * 0.23, 0), BROWN)
            for _, limb in ipairs({ upper, lower }) do
                decorate(model, limb, side .. "Leg", Vector3.new(0.26, limb.Size.Y, 0.28),
                    CFrame.identity, YELLOW)
            end
            decorate(model, lower, side .. "Sock", Vector3.new(0.34, lower.Size.Y * 0.6, 0.36),
                CFrame.new(0, -lower.Size.Y * 0.2, 0), WHITE)
            decorate(model, lower, side .. "SockStripe", Vector3.new(0.35, 0.065, 0.37),
                CFrame.new(0, lower.Size.Y * 0.05, 0), RED)
            decorate(model, foot, side .. "Shoe", Vector3.new(0.65, 0.36, 1.05),
                CFrame.new(0, -0.04, -0.12), BLACK)
        elseif classic then
            decorate(model, classic, side .. "ShortLeg", Vector3.new(0.72, 0.43, 0.8),
                CFrame.new(0, classic.Size.Y * 0.38, 0), BROWN)
            decorate(model, classic, side .. "Leg", Vector3.new(0.28, classic.Size.Y * 0.85, 0.3),
                CFrame.new(0, -0.03, 0), YELLOW)
            decorate(model, classic, side .. "Sock", Vector3.new(0.35, 0.55, 0.38),
                CFrame.new(0, -classic.Size.Y * 0.28, 0), WHITE)
            decorate(model, classic, side .. "SockStripe", Vector3.new(0.36, 0.065, 0.39),
                CFrame.new(0, -classic.Size.Y * 0.17, 0), RED)
            decorate(model, classic, side .. "Shoe", Vector3.new(0.67, 0.38, 1.05),
                CFrame.new(0, -classic.Size.Y * 0.48, -0.17), BLACK)
        end
    end
end

function Costume.apply(character)
    if not character or not character.Parent then
        return nil
    end
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not torso or not torso:IsA("BasePart") then
        return nil
    end
    local previous = character:FindFirstChild("SpongeChefCostume")
    if previous then
        previous:Destroy()
    end
    -- Hide only the actual rig, not a carried burger Tool or unrelated effects.
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") then
            child:Destroy()
        elseif child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
            child.Transparency = 1
            for _, image in ipairs(child:GetDescendants()) do
                if image:IsA("Decal") or image:IsA("Texture") then
                    image.Transparency = 1
                end
            end
        end
    end

    local model = Instance.new("Model")
    model.Name = "SpongeChefCostume"
    model.Parent = character
    local width = math.clamp(torso.Size.X * 1.3, 2.35, 2.95)
    local body = decorate(model, torso, "Sponge", Vector3.new(width, 2.45, 1.02),
        CFrame.new(0, 0.62, 0), YELLOW)
    addFace(body)
    -- A small protruding nose keeps the face readable from an angle.
    decorate(model, torso, "Nose", Vector3.new(0.23, 0.4, 0.42),
        CFrame.new(0, 0.5, -0.67), YELLOW, Enum.PartType.Ball)
    decorate(model, torso, "Shirt", Vector3.new(width + 0.03, 0.37, 1.05),
        CFrame.new(0, -0.79, 0), WHITE)
    decorate(model, torso, "Shorts", Vector3.new(width + 0.04, 0.42, 1.07),
        CFrame.new(0, -1.18, 0), BROWN)
    decorate(model, torso, "TieKnot", Vector3.new(0.17, 0.17, 0.06),
        CFrame.new(0, -0.7, -0.56) * CFrame.Angles(0, 0, math.rad(45)), RED)
    decorate(model, torso, "Tie", Vector3.new(0.15, 0.34, 0.06),
        CFrame.new(0, -0.91, -0.56), RED)
    for _, x in ipairs({ -width * 0.32, width * 0.32 }) do
        decorate(model, torso, "BeltLoop", Vector3.new(0.29, 0.07, 0.04),
            CFrame.new(x, -1.07, -0.56), BLACK)
    end
    dressArms(character, model)
    dressLegs(character, model)
    character:SetAttribute("SpongeChefCostumeApplied", true)
    return model
end

return Costume
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">Game</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local World = require(script.Parent.World)
local Costume = require(script.Parent.Costume)
local ProfileStore = require(script.Parent.ProfileStore)

local remotes = Instance.new("Folder")
remotes.Name = "TycoonRemotes"
remotes.Parent = ReplicatedStorage
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "State"
stateEvent.Parent = remotes
local noticeEvent = Instance.new("RemoteEvent")
noticeEvent.Name = "Notice"
noticeEvent.Parent = remotes
local getState = Instance.new("RemoteFunction")
getState.Name = "GetState"
getState.Parent = remotes

local world = World.build(Config)
local states = {}
local plotOwners = {}
local closing = false
local leavingSaves = 0

local function notice(player, message, kind)
    if player.Parent == Players then
        noticeEvent:FireClient(player, message, kind or "info")
    end
end

local function snapshot(state)
    local grills = {}
    for index, grill in ipairs(state.grills) do
        grills[index] = {
            stage = grill.stage,
            remaining = math.max(0, (grill.readyAt or 0) - os.clock()),
        }
    end
    return {
        cash = state.profile.cash,
        burgersServed = state.profile.burgersServed,
        burgerValue = Economy.burgerValue(Config, state.profile),
        upgrades = table.clone(state.profile.upgrades),
        plotIndex = state.plot and state.plot.index or nil,
        carrying = state.carrying,
        grills = grills,
        persistence = state.persistent,
    }
end

local function publish(state)
    if state.player.Parent ~= Players then return end
    local stats = state.player:FindFirstChild("leaderstats")
    if stats then
        stats.Cash.Value = state.profile.cash
        stats.Burgers.Value = state.profile.burgersServed
    end
    stateEvent:FireClient(state.player, snapshot(state))
end

local function updateGrill(state, index)
    local plot = state.plot
    if not plot then return end
    local station = plot.grills[index]
    local grill = state.grills[index]
    local stage = grill.stage
    local descriptions = {
        Empty = { "Start cooking", "Ready for a fresh patty" },
        Cooking = { "Cooking…", "First side is sizzling…" },
        Flip = { "Flip burger", "Time to flip!" },
        Finishing = { "Cooking…", "Finishing the second side…" },
        Ready = { "Pick up burger", "Order up! Take it to the counter" },
        Locked = { "Buy second grill", "Unlock the second grill" },
    }
    station.prompt.ActionText = descriptions[stage][1]
    station.prompt.ObjectText = "Grill " .. tostring(index)
    station.prompt.Enabled = stage == "Empty" or stage == "Flip" or stage == "Ready"
    station.indicator.Text = descriptions[stage][2]
    World.setBurger(station, stage ~= "Empty" and stage ~= "Locked", stage == "Ready")
end

local function updatePlot(state)
    if not state.plot then return end
    World.updatePlot(state.plot, state.player.DisplayName, state.profile.upgrades, Config)
    if state.profile.upgrades.secondGrill and state.grills[2].stage == "Locked" then
        state.grills[2].stage = "Empty"
    end
    for index in ipairs(state.grills) do
        updateGrill(state, index)
    end
    state.plot.servePrompt.Enabled = true
end

local function aliveAndNear(player, part, distance)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return humanoid and humanoid.Health > 0 and root
        and (root.Position - part.Position).Magnitude <= distance
end

local function validatePrompt(player, plot, prompt)
    local state = states[player]
    if not state or state.leaving or state.plot ~= plot or plotOwners[plot.index] ~= state then
        notice(player, "Find your own restaurant plot to cook or buy upgrades.", "error")
        return nil
    end
    if not prompt.Enabled or not aliveAndNear(player, prompt.Parent, prompt.MaxActivationDistance + 3) then
        return nil
    end
    if os.clock() - state.lastAction < 0.2 then return nil end
    state.lastAction = os.clock()
    return state
end

local function clearCarriedBurger(state)
    if state.carriedTool then state.carriedTool:Destroy() end
    state.carriedTool = nil
    state.carrying = false
end

local function giveBurger(state)
    local tool = Instance.new("Tool")
    tool.Name = "Krabby Patty"
    tool.CanBeDropped = false
    tool.ToolTip = "Carry this burger to your restaurant counter."
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Shape = Enum.PartType.Ball
    handle.Size = Vector3.new(1.5, 0.55, 1.5)
    handle.Color = Color3.fromRGB(232, 169, 72)
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool
    local layers = {
        { -0.26, 0.16, Color3.fromRGB(90, 170, 58) },
        { -0.38, 0.15, Color3.fromRGB(234, 192, 54) },
        { -0.50, 0.23, Color3.fromRGB(108, 57, 31) },
        { -0.67, 0.28, Color3.fromRGB(217, 148, 62) },
    }
    for _, layer in ipairs(layers) do
        local part = Instance.new("Part")
        part.Name = "BurgerLayer"
        part.Shape = Enum.PartType.Ball
        part.Size = Vector3.new(1.4, layer[2], 1.4)
        part.Color = layer[3]
        part.CFrame = handle.CFrame * CFrame.new(0, layer[1], 0)
        part.CanCollide = false
        part.CanTouch = false
        part.Massless = true
        part.Parent = tool
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = part
        weld.Parent = part
    end
    state.carriedTool = tool
    state.carrying = true
    tool.Parent = state.player:FindFirstChildOfClass("Backpack") or state.player.Character
    local humanoid = state.player.Character and state.player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid:EquipTool(tool) end
end

local function later(state, grill, seconds, callback)
    grill.token += 1
    local token = grill.token
    grill.readyAt = os.clock() + seconds
    task.delay(seconds, function()
        if states[state.player] == state and not state.leaving and grill.token == token then
            grill.readyAt = nil
            callback()
        end
    end)
end

local function useGrill(player, plot, index)
    local state = validatePrompt(player, plot, plot.grills[index].prompt)
    if not state then return end
    local grill = state.grills[index]
    if grill.stage == "Empty" then
        grill.stage = "Cooking"
        later(state, grill, Config.CookSeconds * Economy.cookMultiplier(state.profile), function()
            grill.stage = "Flip"
            updateGrill(state, index)
            publish(state)
            notice(player, "Grill " .. index .. ": time to flip your burger!")
        end)
        notice(player, "Patty on the grill! Wait for the flip cue.")
    elseif grill.stage == "Flip" then
        grill.stage = "Finishing"
        if World.flipBurger then World.flipBurger(plot.grills[index]) end
        later(state, grill, Config.FinishSeconds * Economy.cookMultiplier(state.profile), function()
            grill.stage = "Ready"
            updateGrill(state, index)
            publish(state)
            notice(player, "Order up! Pick up the burger from grill " .. index .. ".", "success")
        end)
        notice(player, "Nice flip! Let the other side cook.", "success")
    elseif grill.stage == "Ready" then
        if state.carrying then
            notice(player, "Serve the burger you're holding before picking up another.", "error")
            return
        end
        giveBurger(state)
        grill.stage = "Empty"
        notice(player, "Take your Krabby Patty to the front counter.")
    else
        return
    end
    updateGrill(state, index)
    publish(state)
end

local function serve(player, plot)
    local state = validatePrompt(player, plot, plot.servePrompt)
    if not state then return end
    if not state.carrying or not state.carriedTool or not state.carriedTool.Parent then
        clearCarriedBurger(state)
        publish(state)
        notice(player, "Cook, flip, and pick up a burger first.", "error")
        return
    end
    clearCarriedBurger(state)
    local earned = Economy.serve(Config, state.profile)
    publish(state)
    notice(player, "Happy customer! +$" .. earned .. ". Save up for your next upgrade!", "success")
end

local function buy(player, plot, id)
    local prompt = plot.upgradePrompts[id]
    local state = validatePrompt(player, plot, prompt)
    if not state then return end
    local success, message = Economy.purchase(Config, state.profile, id)
    if success then
        updatePlot(state)
        publish(state)
    end
    notice(player, message, if success then "success" else "error")
end

local function teleportToPlot(state, character)
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        character:PivotTo(if state.plot then state.plot.spawn else world.spawn)
    end
end

local function assignPlot(state)
    for _, plot in ipairs(world.plots) do
        if not plotOwners[plot.index] then
            plotOwners[plot.index] = state
            state.plot = plot
            state.grills = {
                { stage = "Empty", token = 0 },
                { stage = if state.profile.upgrades.secondGrill then "Empty" else "Locked", token = 0 },
            }
            updatePlot(state)
            if state.player.Character then teleportToPlot(state, state.player.Character) end
            publish(state)
            return true
        end
    end
    return false
end

for _, plot in ipairs(world.plots) do
    World.updatePlot(plot, nil, {}, Config)
    for index, grill in ipairs(plot.grills) do
        grill.prompt.Enabled = false
        grill.prompt.Triggered:Connect(function(player) useGrill(player, plot, index) end)
    end
    plot.servePrompt.Enabled = false
    plot.servePrompt.Triggered:Connect(function(player) serve(player, plot) end)
    for id, prompt in pairs(plot.upgradePrompts) do
        prompt.Enabled = false
        prompt.Triggered:Connect(function(player) buy(player, plot, id) end)
    end
end

for index, coin in ipairs(world.coins) do
    coin.Touched:Connect(function(hit)
        local player = Players:GetPlayerFromCharacter(hit.Parent)
        if not player and hit.Parent.Parent then
            player = Players:GetPlayerFromCharacter(hit.Parent.Parent)
        end
        local state = player and states[player]
        if not state or state.leaving or not aliveAndNear(player, coin, 8) then return end
        local now = os.clock()
        if now < (state.coinTimes[index] or 0) then return end
        state.coinTimes[index] = now + Config.CollectibleCooldown
        state.profile.cash += Config.CollectibleCash
        publish(state)
        notice(player, "Sand dollar! +$" .. Config.CollectibleCash .. " (returns in 30s)", "success")
    end)
end

getState.OnServerInvoke = function(player)
    local state = states[player]
    if state then return snapshot(state) end
    return nil
end

local function characterAdded(state, character)
    if not character:WaitForChild("HumanoidRootPart", 10) then return end
    if states[state.player] ~= state or state.player.Character ~= character then return end
    clearCarriedBurger(state)
    teleportToPlot(state, character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = 20
        humanoid.Died:Connect(function()
            if states[state.player] == state then
                clearCarriedBurger(state)
                publish(state)
            end
        end)
    end
    task.delay(0.5, function()
        if character.Parent and state.player.Character == character then Costume.apply(character) end
    end)
    publish(state)
end

local function playerAdded(player)
    local stored = ProfileStore.load(player, Config, Economy)
    if closing or player.Parent ~= Players then
        ProfileStore.save(player, stored, true)
        return
    end
    local state = stored
    state.player = player
    state.grills = {}
    state.carrying = false
    state.coinTimes = {}
    state.lastAction = 0
    states[player] = state
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player
    for _, name in ipairs({ "Cash", "Burgers" }) do
        local value = Instance.new("IntValue")
        value.Name = name
        value.Parent = stats
    end
    player.CharacterAdded:Connect(function(character)
        task.spawn(characterAdded, state, character)
    end)
    player.CharacterAppearanceLoaded:Connect(function(character)
        if character.Parent and player.Character == character then Costume.apply(character) end
    end)
    if not assignPlot(state) then
        notice(player, "All four restaurants are busy. Explore and collect sand dollars while you wait.")
    end
    if player.Character then task.spawn(characterAdded, state, player.Character) end
    publish(state)
    if state.warning then
        task.delay(3, function() notice(player, state.warning, "error") end)
    end
end

local function playerRemoving(player)
    local state = states[player]
    if not state then return end
    state.leaving = true
    clearCarriedBurger(state)
    if state.plot then
        local plot = state.plot
        plotOwners[plot.index] = nil
        World.updatePlot(plot, nil, {}, Config)
        for _, grill in ipairs(plot.grills) do
            grill.prompt.Enabled = false
            World.setBurger(grill, false, false)
        end
        plot.servePrompt.Enabled = false
        for _, prompt in pairs(plot.upgradePrompts) do prompt.Enabled = false end
    end
    states[player] = nil
    if not closing then
        for _, waiting in pairs(states) do
            if not waiting.plot and not waiting.leaving then assignPlot(waiting) end
        end
    end
    leavingSaves += 1
    ProfileStore.save(player, state, true)
    leavingSaves -= 1
end

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(playerRemoving)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(playerAdded, player) end

task.spawn(function()
    while not closing do
        task.wait(60)
        for player, state in pairs(states) do
            if state.persistent and not state.leaving then
                task.spawn(function()
                    ProfileStore.save(player, state, false)
                    publish(state)
                end)
            end
        end
    end
end)

game:BindToClose(function()
    closing = true
    local pending = 0
    for player, state in pairs(states) do
        if not state.leaving then
            state.leaving = true
            pending += 1
            task.spawn(function()
                ProfileStore.save(player, state, true)
                pending -= 1
            end)
        end
    end
    local deadline = os.clock() + 25
    while (pending > 0 or leavingSaves > 0) and os.clock() < deadline do task.wait(0.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[-- Optional DataStore persistence. Failed/locked loads stay strictly session-only.
local Store = {}
local LEASE_SECONDS = 180
local serverSession
local loadSequence = 0

local function sessionId()
    if not serverSession then
        local ok, id = pcall(function()
            return game:GetService("HttpService"):GenerateGUID(false)
        end)
        local candidate = if ok and type(id) == "string" and id ~= "" then id else game.JobId
        assert(type(candidate) == "string" and candidate ~= "", "No unique session ID available")
        serverSession = candidate
    end
    return serverSession
end

function Store.load(player, config, economy)
    local state = {
        profile = economy.newProfile(config),
        persistent = false,
        _config = config,
        _economy = economy,
    }
    if not config.PersistenceEnabled then
        return state
    end

    local locked = false
    local ok, stored = pcall(function()
        loadSequence += 1
        state._session = sessionId() .. ":" .. tostring(loadSequence)
        state._key = "player_" .. tostring(player.UserId)
        state._store = game:GetService("DataStoreService"):GetDataStore(config.DataStoreName)
        return state._store:UpdateAsync(state._key, function(previous)
            locked = type(previous) == "table"
                and type(previous._session) == "string"
                and previous._session ~= state._session
                and type(previous._expiresAt) == "number"
                and previous._expiresAt > os.time()
            if locked then
                return nil
            end
            local profile = economy.sanitizeProfile(config, previous)
            profile._session = state._session
            profile._expiresAt = os.time() + LEASE_SECONDS
            return profile
        end)
    end)

    if not ok or type(stored) ~= "table" or stored._session ~= state._session then
        state.warning = if locked
            then "Your save is open in another server. This visit will not save progress."
            else "Saving is unavailable. This visit will not save progress."
        return state
    end

    state.profile = economy.sanitizeProfile(config, stored)
    state.persistent = true
    return state
end

function Store.save(player, state, release)
    if not state.persistent then
        return false
    end
    if state._saving then
        if not release then
            return false
        end
        local deadline = os.clock() + 8
        repeat
            task.wait(0.1)
        until not state._saving or os.clock() >= deadline
        if state._saving or not state.persistent then
            return false
        end
    end

    state._saving = true
    local lostLease = false
    local ok, result = pcall(function()
        -- Sanitation copies only the public profile, never internal state or Instances.
        local snapshot = state._economy.sanitizeProfile(state._config, state.profile)
        return state._store:UpdateAsync(state._key, function(previous)
            lostLease = type(previous) ~= "table" or previous._session ~= state._session
            if lostLease then
                return nil
            end
            if not release then
                snapshot._session = state._session
                snapshot._expiresAt = os.time() + LEASE_SECONDS
            end
            return snapshot
        end)
    end)
    state._saving = false

    if lostLease then
        state.persistent = false
        state.warning = "Your save moved to another server. Further progress here will not save."
        warn("Profile lease lost for user " .. tostring(player.UserId))
        return false
    end
    if not ok or type(result) ~= "table" then
        warn("Profile save failed for user " .. tostring(player.UserId))
        return false
    end
    if release then
        state.persistent = false
    end
    return true
end

return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Procedural seaside restaurant town. No Toolbox models or external asset IDs.
local World = {}
local TweenService = game:GetService("TweenService")

local colors = {
    sand = Color3.fromRGB(242, 220, 157),
    path = Color3.fromRGB(224, 198, 140),
    wood = Color3.fromRGB(145, 88, 45),
    plank = Color3.fromRGB(188, 131, 73),
    darkWood = Color3.fromRGB(94, 58, 40),
    roof = Color3.fromRGB(178, 60, 48),
    turquoise = Color3.fromRGB(55, 179, 179),
    blue = Color3.fromRGB(43, 116, 150),
    sponge = Color3.fromRGB(255, 222, 61),
    coral = Color3.fromRGB(255, 143, 143),
    mint = Color3.fromRGB(87, 221, 171),
    gold = Color3.fromRGB(255, 193, 62),
}

local function model(parent, name)
    local result = Instance.new("Model")
    result.Name = name
    result.Parent = parent
    return result
end

local function part(parent, name, size, transform, color, material)
    local result = Instance.new("Part")
    result.Name = name
    result.Size = size
    result.CFrame = transform
    result.Color = color
    result.Material = material or Enum.Material.SmoothPlastic
    result.Anchored = true
    result.TopSurface = Enum.SurfaceType.Smooth
    result.BottomSurface = Enum.SurfaceType.Smooth
    result.Parent = parent
    return result
end

local function ball(parent, name, size, transform, color, material)
    local result = part(parent, name, size, transform, color, material)
    result.Shape = Enum.PartType.Ball
    return result
end

local function disc(parent, name, diameter, thickness, transform, color, material)
    local result = part(parent, name, Vector3.new(thickness, diameter, diameter),
        transform * CFrame.Angles(0, 0, math.rad(90)), color, material)
    result.Shape = Enum.PartType.Cylinder
    return result
end

local function billboard(parent, text, width, height, offset, color)
    local gui = Instance.new("BillboardGui")
    gui.Name = "WorldLabel"
    gui.Size = UDim2.fromOffset(width, height)
    gui.StudsOffsetWorldSpace = offset or Vector3.new(0, 3, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 100
    gui.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = Color3.fromRGB(22, 65, 74)
    label.BackgroundTransparency = 0.12
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = label
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 5)
    padding.PaddingBottom = UDim.new(0, 5)
    padding.PaddingLeft = UDim.new(0, 9)
    padding.PaddingRight = UDim.new(0, 9)
    padding.Parent = label
    return label
end

local function surface(parent, text, color)
    local gui = Instance.new("SurfaceGui")
    gui.Name = "SignText"
    gui.Face = Enum.NormalId.Front
    gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    gui.PixelsPerStud = 36
    gui.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.TextScaled = true
    label.TextWrapped = true
    label.Font = Enum.Font.GothamBlack
    label.Parent = gui
    return label
end

local function prompt(parent, action, object)
    local result = Instance.new("ProximityPrompt")
    result.Name = "Interact"
    result.ActionText = action
    result.ObjectText = object
    result.KeyboardKeyCode = Enum.KeyCode.E
    result.GamepadKeyCode = Enum.KeyCode.ButtonX
    result.HoldDuration = 0.12
    result.MaxActivationDistance = 10
    result.RequiresLineOfSight = false
    result.Parent = parent
    return result
end

local function visible(group, enabled)
    for _, descendant in ipairs(group:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Transparency = if enabled then (descendant:GetAttribute("VisibleTransparency") or 0) else 1
            descendant.CanCollide = enabled and descendant:GetAttribute("Solid") == true
        elseif descendant:IsA("SurfaceGui") or descendant:IsA("BillboardGui") then
            descendant.Enabled = enabled
        elseif descendant:IsA("Light") then
            descendant.Enabled = enabled
        end
    end
end

local function prepareGroup(group)
    for _, descendant in ipairs(group:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant:SetAttribute("VisibleTransparency", descendant.Transparency)
            descendant:SetAttribute("Solid", descendant.CanCollide)
        end
    end
end

local function spongeCustomer(parent, origin, shirtColor)
    local customer = model(parent, "Hungry customer")
    part(customer, "Sponge", Vector3.new(3.2, 3, 1.4), origin * CFrame.new(0, 4.1, 0), colors.sponge)
    part(customer, "Shirt", Vector3.new(3.2, 0.65, 1.4), origin * CFrame.new(0, 2.5, 0), shirtColor)
    part(customer, "Shorts", Vector3.new(3.2, 0.8, 1.4), origin * CFrame.new(0, 1.8, 0), colors.wood)
    for _, side in ipairs({ -1, 1 }) do
        part(customer, "Leg", Vector3.new(0.5, 1.2, 0.5), origin * CFrame.new(side * 0.8, 1, 0), colors.sponge)
        part(customer, "Shoe", Vector3.new(1, 0.5, 1.6), origin * CFrame.new(side * 0.8, 0.35, -0.2), colors.darkWood)
        ball(customer, "Eye", Vector3.new(0.95, 1, 0.3), origin * CFrame.new(side * 0.62, 4.55, -0.8), Color3.new(1, 1, 1))
        ball(customer, "Iris", Vector3.new(0.4, 0.5, 0.16), origin * CFrame.new(side * 0.62, 4.55, -0.98), colors.blue)
        ball(customer, "Pupil", Vector3.new(0.2, 0.3, 0.1), origin * CFrame.new(side * 0.62, 4.55, -1.08), Color3.fromRGB(25, 36, 42))
    end
    part(customer, "Smile", Vector3.new(1.25, 0.16, 0.15), origin * CFrame.new(0, 3.7, -0.78), colors.darkWood)
    for _, side in ipairs({ -1, 1 }) do
        part(customer, "Tooth", Vector3.new(0.3, 0.38, 0.16), origin * CFrame.new(side * 0.2, 3.6, -0.9), Color3.new(1, 1, 1))
    end
    for _, descendant in ipairs(customer:GetDescendants()) do
        if descendant:IsA("BasePart") then descendant.CanCollide = false end
    end
    return customer
end

local function grill(parent, origin, number)
    local group = model(parent, "Grill " .. tostring(number))
    local base = part(group, "Grill base", Vector3.new(9, 3.5, 6), origin * CFrame.new(0, 2.75, 0), Color3.fromRGB(85, 103, 105), Enum.Material.Metal)
    local top = part(group, "Cooking surface", Vector3.new(9.5, 0.35, 6.5), origin * CFrame.new(0, 4.7, 0), Color3.fromRGB(40, 49, 53), Enum.Material.Metal)
    for index = -3, 3 do
        part(group, "Grill stripe", Vector3.new(0.1, 0.06, 5.6), origin * CFrame.new(index * 1.2, 4.92, 0), Color3.fromRGB(115, 124, 124), Enum.Material.Metal)
    end
    for _, side in ipairs({ -1, 1 }) do
        local knob = ball(group, "Heat control", Vector3.new(0.7, 0.7, 0.35), origin * CFrame.new(side * 2, 2.9, -3.12), colors.roof)
        knob.CanCollide = false
    end
    local burger = model(group, "Burger")
    disc(burger, "Patty", 2.6, 0.45, origin * CFrame.new(0, 5.25, 0), Color3.fromRGB(193, 99, 91))
    local bun = disc(burger, "Top bun", 2.9, 0.7, origin * CFrame.new(0, 5.9, 0), Color3.fromRGB(234, 172, 74))
    bun:SetAttribute("CookedOnly", true)
    local lettuce = disc(burger, "Lettuce", 3, 0.15, origin * CFrame.new(0, 5.53, 0), colors.mint)
    lettuce:SetAttribute("CookedOnly", true)
    for _, descendant in ipairs(burger:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false
            descendant.Transparency = 1
        end
    end
    local stationPrompt = prompt(top, "Start burger", "Grill " .. tostring(number))
    local indicator = billboard(top, "GRILL " .. tostring(number) .. "\nReady to cook", 180, 52, Vector3.new(0, 3.8, 0))
    prepareGroup(group)
    return { model = group, part = base, prompt = stationPrompt, burger = burger, indicator = indicator }
end

local function tableSet(parent, origin)
    local group = model(parent, "Table and seats")
    disc(group, "Table top", 5.5, 0.5, origin * CFrame.new(0, 3.7, 0), colors.plank, Enum.Material.Wood)
    part(group, "Table leg", Vector3.new(0.6, 3.2, 0.6), origin * CFrame.new(0, 1.8, 0), colors.darkWood, Enum.Material.Wood)
    for _, side in ipairs({ -1, 1 }) do
        part(group, "Seat", Vector3.new(3.4, 0.5, 2.1), origin * CFrame.new(side * 4, 2.15, 0), colors.coral)
        part(group, "Seat leg", Vector3.new(0.6, 1.8, 0.6), origin * CFrame.new(side * 4, 1.05, 0), colors.darkWood)
    end
end

local function jellyfish(parent, origin, color)
    local cap = ball(parent, "Jellyfish bell", Vector3.new(3.8, 2.7, 3.8), origin, color, Enum.Material.Neon)
    cap.CanCollide = false
    cap.Transparency = 0.18
    for index = 1, 4 do
        local angle = index * math.pi * 0.5
        local tentacle = part(parent, "Jellyfish tentacle", Vector3.new(0.18, 3.4, 0.18),
            origin * CFrame.new(math.cos(angle), -2.4, math.sin(angle)) * CFrame.Angles(0, 0, math.rad(12)), color, Enum.Material.Neon)
        tentacle.CanCollide = false
    end
end

local function plot(parent, origin, index, config)
    local group = model(parent, "Restaurant plot " .. tostring(index))
    local deck = part(group, "Restaurant deck", Vector3.new(54, 1.4, 42), origin * CFrame.new(0, 0.8, 2), colors.plank, Enum.Material.WoodPlanks)
    part(group, "Back wall", Vector3.new(54, 11, 1), origin * CFrame.new(0, 6.4, 23), colors.wood, Enum.Material.WoodPlanks)
    for _, side in ipairs({ -1, 1 }) do
        part(group, "Low side wall", Vector3.new(1, 3, 42), origin * CFrame.new(side * 27, 2.8, 2), colors.wood, Enum.Material.WoodPlanks)
        for _, depth in ipairs({ -18, 22 }) do
            part(group, "Roof post", Vector3.new(1.2, 11, 1.2), origin * CFrame.new(side * 26, 6.4, depth), colors.darkWood, Enum.Material.Wood)
        end
        -- A cutaway roof leaves the cooking area visible to the third-person camera.
        local roof = part(group, "Roof wing", Vector3.new(14, 1.2, 43),
            origin * CFrame.new(side * 21, 12.2, 2) * CFrame.Angles(0, 0, math.rad(side * 12)), colors.roof, Enum.Material.WoodPlanks)
        roof.CanCollide = false
        part(group, "Round window rim", Vector3.new(9, 7, 0.4), origin * CFrame.new(side * 16, 7.7, 22.35), colors.darkWood)
        local glass = part(group, "Blue window", Vector3.new(7.5, 5.5, 0.5), origin * CFrame.new(side * 16, 7.7, 22), colors.turquoise, Enum.Material.Glass)
        glass.Transparency = 0.35
    end
    local sign = part(group, "Restaurant sign", Vector3.new(29, 5.2, 0.8), origin * CFrame.new(0, 11.4, -18.7), colors.darkWood, Enum.Material.Wood)
    surface(sign, "THE KRUSTY KRAB", colors.gold)
    local ownerAnchor = part(group, "Owner name anchor", Vector3.new(1, 1, 1), origin * CFrame.new(0, 13.5, -20), colors.darkWood)
    ownerAnchor.Transparency = 1
    ownerAnchor.CanCollide = false
    local ownerLabel = billboard(ownerAnchor, "UNCLAIMED RESTAURANT", 280, 36, Vector3.new(0, 2, 0), colors.gold)
    local counter = part(group, "Order counter", Vector3.new(16, 3.7, 3.6), origin * CFrame.new(0, 3.1, -13.5), colors.turquoise, Enum.Material.Wood)
    part(group, "Counter top", Vector3.new(17, 0.45, 4), origin * CFrame.new(0, 5.2, -13.5), colors.gold)
    local servePrompt = prompt(counter, "Serve burger", "Hungry customer · $25+")
    billboard(counter, "ORDER PICKUP\nBring a cooked burger here", 220, 52, Vector3.new(0, 5.6, 0))
    spongeCustomer(group, origin * CFrame.new(-5, 0, -24) * CFrame.Angles(0, math.pi, 0), Color3.new(1, 1, 1))
    spongeCustomer(group, origin * CFrame.new(5, 0, -27) * CFrame.Angles(0, math.pi, 0), colors.coral)
    local grills = {
        grill(group, origin * CFrame.new(-13, 0, 8), 1),
        grill(group, origin * CFrame.new(13, 0, 8), 2),
    }

    local upgradeGroups = {}
    local dining = model(group, "Dining room upgrade")
    tableSet(dining, origin * CFrame.new(-15, 0, -4))
    tableSet(dining, origin * CFrame.new(15, 0, -4))
    upgradeGroups.diningRoom = dining

    local neon = model(group, "Neon sign upgrade")
    local neonBoard = part(neon, "Neon board", Vector3.new(23, 3.4, 0.5), origin * CFrame.new(0, 16, -18.8), colors.turquoise, Enum.Material.Neon)
    neonBoard.CanCollide = false
    surface(neonBoard, "FRESH PATTIES • BIG SMILES", Color3.new(1, 1, 1))
    local light = Instance.new("PointLight")
    light.Color = colors.turquoise
    light.Brightness = 1.5
    light.Range = 20
    light.Parent = neonBoard
    upgradeGroups.neonSign = neon

    local garden = model(group, "Jellyfish garden upgrade")
    disc(garden, "Garden sand", 17, 0.45, origin * CFrame.new(36, 0.35, 4), Color3.fromRGB(231, 205, 173), Enum.Material.Sand)
    jellyfish(garden, origin * CFrame.new(33, 7, 1), colors.coral)
    jellyfish(garden, origin * CFrame.new(39, 9, 7), Color3.fromRGB(211, 147, 247))
    upgradeGroups.jellyfishGarden = garden

    local gold = model(group, "Golden spatula upgrade")
    part(gold, "Trophy pedestal", Vector3.new(3, 2, 3), origin * CFrame.new(0, 2.4, 18), colors.darkWood)
    local handle = part(gold, "Golden handle", Vector3.new(0.45, 5, 0.45), origin * CFrame.new(0, 5.5, 18), colors.gold, Enum.Material.Metal)
    handle.CanCollide = false
    part(gold, "Spatula blade", Vector3.new(2.8, 2.4, 0.35), origin * CFrame.new(0, 9, 18), colors.gold, Enum.Material.Metal)
    billboard(handle, "MASTER FRY COOK", 190, 32, Vector3.new(0, 5.7, 0), colors.gold)
    upgradeGroups.goldenSpatula = gold

    local sauce = model(group, "Secret sauce upgrade")
    local bottle = part(sauce, "Sauce bottle", Vector3.new(1.1, 2.1, 1.1), origin * CFrame.new(-7, 6.5, -13.5), colors.roof)
    bottle.CanCollide = false
    part(sauce, "Bottle cap", Vector3.new(0.55, 0.45, 0.55), origin * CFrame.new(-7, 7.8, -13.5), colors.gold).CanCollide = false
    upgradeGroups.secretSauce = sauce

    local speedy = model(group, "Fast grill upgrade")
    local badge = part(speedy, "Turbo grill badge", Vector3.new(8, 1.6, 0.25), origin * CFrame.new(0, 8, 22), colors.gold, Enum.Material.Neon)
    badge.CanCollide = false
    surface(badge, "QUICK FLIP", colors.darkWood)
    upgradeGroups.speedyGrill = speedy

    local upgradePrompts = {}
    local upgradePads = {}
    for position, upgrade in ipairs(config.Upgrades) do
        -- All purchases share one spot; only the next available pad is shown.
        local padGroup = model(group, upgrade.name .. " purchase pad")
        local pad = disc(padGroup, "Upgrade pad", 7, 0.3, origin * CFrame.new(35, 0.6, -15), colors.mint, Enum.Material.Neon)
        local anchor = part(padGroup, "Prompt anchor", Vector3.new(1, 1, 1), origin * CFrame.new(35, 2.4, -15), colors.mint)
        anchor.Transparency = 1
        anchor.CanCollide = false
        billboard(anchor, upgrade.name .. "\n$" .. tostring(upgrade.cost), 190, 55, Vector3.new(0, 3, 0), colors.gold)
        local purchasePrompt = prompt(anchor, "Buy · $" .. tostring(upgrade.cost), upgrade.name)
        purchasePrompt:SetAttribute("UpgradeId", upgrade.id)
        purchasePrompt:SetAttribute("Order", position)
        upgradePrompts[upgrade.id] = purchasePrompt
        prepareGroup(padGroup)
        upgradePads[upgrade.id] = padGroup
    end
    for _, groupToPrepare in pairs(upgradeGroups) do prepareGroup(groupToPrepare) end

    local result = {
        index = index,
        origin = origin,
        model = group,
        spawn = origin * CFrame.new(0, 5, -7),
        grills = grills,
        servePrompt = servePrompt,
        upgradePrompts = upgradePrompts,
        ownerLabel = ownerLabel,
        upgradeGroups = upgradeGroups,
        upgradePads = upgradePads,
        deck = deck,
    }
    World.updatePlot(result, nil, {}, config)
    return result
end

function World.setBurger(station, enabled, cooked)
    for _, descendant in ipairs(station.burger:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Transparency = if enabled and (cooked or not descendant:GetAttribute("CookedOnly")) then 0 else 1
            descendant:SetAttribute("VisibleTransparency", descendant.Transparency)
            if descendant.Name == "Patty" then
                descendant.Color = if cooked then Color3.fromRGB(104, 58, 35) else Color3.fromRGB(193, 99, 91)
            end
        end
    end
end

function World.flipBurger(station)
    local burger = station.burger
    local start = burger:GetPivot()
    local progress = Instance.new("NumberValue")
    progress.Value = 0
    local changed = progress.Changed:Connect(function(alpha)
        if burger.Parent then
            burger:PivotTo(start * CFrame.new(0, math.sin(alpha * math.pi) * 2.6, 0)
                * CFrame.Angles(alpha * math.pi * 2, 0, 0))
        end
    end)
    local tween = TweenService:Create(progress, TweenInfo.new(0.5, Enum.EasingStyle.Linear), { Value = 1 })
    tween.Completed:Connect(function()
        changed:Disconnect()
        progress:Destroy()
        if burger.Parent then burger:PivotTo(start) end
    end)
    tween:Play()
end

function World.updatePlot(restaurant, playerName, upgrades, config)
    restaurant.ownerLabel.Text = if playerName then string.upper(playerName) .. "'S KRUSTY KRAB" else "UNCLAIMED RESTAURANT"
    for id, group in pairs(restaurant.upgradeGroups) do
        visible(group, playerName ~= nil and upgrades[id] == true)
    end
    visible(restaurant.grills[2].model, playerName ~= nil and upgrades.secondGrill == true)
    restaurant.grills[1].prompt.Enabled = playerName ~= nil
    restaurant.grills[2].prompt.Enabled = playerName ~= nil and upgrades.secondGrill == true
    restaurant.servePrompt.Enabled = playerName ~= nil
    for _, upgrade in ipairs(config.Upgrades) do
        local available = playerName ~= nil and not upgrades[upgrade.id]
            and (not upgrade.requires or upgrades[upgrade.requires] == true)
        visible(restaurant.upgradePads[upgrade.id], available)
        restaurant.upgradePrompts[upgrade.id].Enabled = available
    end
end

local function coral(parent, transform, color)
    for index = -1, 1 do
        local branch = part(parent, "Coral branch", Vector3.new(1.3, 5 + index, 1.3),
            transform * CFrame.new(index * 1.5, (5 + index) / 2, 0) * CFrame.Angles(0, 0, math.rad(index * -18)), color)
        branch.CanCollide = false
        ball(parent, "Coral tip", Vector3.new(2, 2, 2), transform * CFrame.new(index * 2, 5 + index, 0), color).CanCollide = false
    end
end

local function pineapple(parent, origin)
    local home = model(parent, "Pineapple home")
    ball(home, "Pineapple", Vector3.new(20, 27, 20), origin * CFrame.new(0, 13, 0), Color3.fromRGB(238, 164, 45))
    for index = 0, 7 do
        local angle = index * math.pi / 4
        local leaf = part(home, "Pineapple leaf", Vector3.new(3, 13, 2),
            origin * CFrame.new(math.cos(angle) * 3, 30, math.sin(angle) * 3) * CFrame.Angles(math.sin(angle) * 0.5, angle, math.cos(angle) * 0.5), Color3.fromRGB(80, 158, 73))
        leaf.CanCollide = false
    end
    part(home, "Front door", Vector3.new(5, 8, 1), origin * CFrame.new(0, 4.5, -9.5), colors.blue)
    ball(home, "Porthole window", Vector3.new(5, 5, 1), origin * CFrame.new(5, 13, -8), colors.turquoise)
    for height = 5, 22, 5 do
        local ring = disc(home, "Pineapple groove", 19.5 - math.abs(height - 13) * 0.3, 0.18, origin * CFrame.new(0, height, 0), Color3.fromRGB(202, 126, 38))
        ring.CanCollide = false
    end
    billboard(home.PrimaryPart or home:FindFirstChild("Pineapple"), "HOME SWEET PINEAPPLE", 240, 35, Vector3.new(0, 24, 0), colors.gold)
end

function World.build(config)
    local existing = workspace:FindFirstChild("BurgerTown")
    if existing then existing:Destroy() end
    local root = model(workspace, "BurgerTown")
    part(root, "Ocean floor", Vector3.new(440, 4, 440), CFrame.new(0, -2, 0), colors.sand, Enum.Material.Sand)
    part(root, "Main promenade", Vector3.new(22, 0.12, 300), CFrame.new(0, 0.08, 0), colors.path, Enum.Material.Sand)
    part(root, "Cross promenade", Vector3.new(300, 0.12, 20), CFrame.new(0, 0.1, 0), colors.path, Enum.Material.Sand)
    disc(root, "Central plaza", 39, 0.25, CFrame.new(0, 0.22, 0), colors.turquoise, Enum.Material.SmoothPlastic)
    local welcome = part(root, "Welcome sign", Vector3.new(19, 5, 0.8), CFrame.new(0, 7, -18), colors.darkWood, Enum.Material.Wood)
    surface(welcome, "BIKINI BOTTOM\nCOOK • FLIP • UPGRADE", colors.gold)
    for _, side in ipairs({ -1, 1 }) do
        part(root, "Welcome sign post", Vector3.new(0.9, 7, 0.9), CFrame.new(side * 8, 3.7, -18), colors.wood, Enum.Material.Wood)
    end
    local spawnPoint = Instance.new("SpawnLocation")
    spawnPoint.Name = "Town spawn"
    spawnPoint.Size = Vector3.new(10, 0.4, 10)
    spawnPoint.CFrame = CFrame.new(0, 0.7, 6)
    spawnPoint.Anchored = true
    spawnPoint.Neutral = true
    spawnPoint.Duration = 0
    spawnPoint.Transparency = 1
    spawnPoint.Parent = root

    local plots = {}
    local origins = {
        CFrame.new(-65, 0, 65), CFrame.new(65, 0, 65),
        CFrame.new(-65, 0, -65) * CFrame.Angles(0, math.pi, 0),
        CFrame.new(65, 0, -65) * CFrame.Angles(0, math.pi, 0),
    }
    for index = 1, math.min(config.MaxPlots, #origins) do
        plots[index] = plot(root, origins[index], index, config)
        local origin = origins[index]
        part(root, "Restaurant walkway", Vector3.new(12, 0.15, 26), origin * CFrame.new(0, 0.12, -34), colors.path, Enum.Material.Sand)
    end

    pineapple(root, CFrame.new(-105, 0, 0))
    local rockHome = ball(root, "Rock home", Vector3.new(23, 15, 20), CFrame.new(108, 3, 0), Color3.fromRGB(155, 119, 109), Enum.Material.Rock)
    billboard(rockHome, "THE NEIGHBORHOOD", 190, 30, Vector3.new(0, 14, 0), colors.gold)
    for index = 1, 24 do
        local angle = index * math.pi * 2 / 24
        local distance = 145 + (index % 3) * 12
        coral(root, CFrame.new(math.cos(angle) * distance, 0, math.sin(angle) * distance),
            if index % 2 == 0 then colors.coral else Color3.fromRGB(166, 139, 213))
    end
    for index = 1, 12 do
        local angle = index * math.pi * 2 / 12
        local bubble = ball(root, "Ocean bubble", Vector3.new(4, 4, 4),
            CFrame.new(math.cos(angle) * 128, 25 + (index % 4) * 9, math.sin(angle) * 128), Color3.fromRGB(193, 247, 248), Enum.Material.Glass)
        bubble.Transparency = 0.65
        bubble.CanCollide = false
    end

    -- Broad stepping stones form an optional free-roam park, with no death traps.
    for index = 1, 7 do
        disc(root, "Jellyfish stepping stone", 9, 2,
            CFrame.new(-30 + index * 9, 1 + (index % 3) * 1.5, 123 + math.sin(index) * 7),
            if index % 2 == 0 then colors.coral else colors.turquoise)
    end
    jellyfish(root, CFrame.new(-25, 12, 140), colors.coral)
    jellyfish(root, CFrame.new(25, 15, 140), Color3.fromRGB(205, 145, 243))

    local coins = {}
    local coinPositions = {
        Vector3.new(-22, 3, 0), Vector3.new(22, 3, 0),
        Vector3.new(0, 3, 34), Vector3.new(0, 3, -34),
        Vector3.new(-110, 3, -20), Vector3.new(110, 3, 20),
        Vector3.new(-21, 7, 129), Vector3.new(6, 7, 118), Vector3.new(33, 7, 128),
        Vector3.new(0, 3, -135),
    }
    for index, position in ipairs(coinPositions) do
        local coin = disc(root, "Sand dollar " .. tostring(index), 3.3, 0.55,
            CFrame.new(position) * CFrame.Angles(math.rad(90), 0, 0), colors.gold, Enum.Material.Neon)
        coin.CanCollide = false
        coin.CanTouch = true
        billboard(coin, "+$" .. tostring(config.CollectibleCash), 72, 27, Vector3.new(0, 2.8, 0), colors.gold)
        table.insert(coins, coin)
    end

    return { model = root, plots = plots, spawn = CFrame.new(0, 4, 6), coins = coins }
end

return World
]]></string>
